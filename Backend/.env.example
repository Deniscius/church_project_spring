# Copier vers Backend/.env (non versionné) et renseigner les valeurs locales.
# Ne jamais committer de secrets réels.
# Au démarrage, LocalDotEnvLoader charge ce fichier s'il est présent.

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/church_project_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me-local

# Base64 d'au moins 32 octets aléatoires (ex. openssl rand -base64 32)
# Remplacer par une valeur unique locale — ne jamais réutiliser l'exemple en prod.
JWT_SECRET=
JWT_ISSUER=missanye-api
JWT_AUDIENCE=missanye-web

# Cookie d'auth HttpOnly (dev local via proxy Vite : Secure=false, SameSite=Lax)
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax
JWT_COOKIE_ENCRYPT=true

APP_ADMIN_SEED_PASSWORD=ChangeMeLocally123!

# Optionnel FedaPay sandbox — voir docs/FEDAPAY.md
# Clé secrète dashboard (sk_sandbox_…) — jamais la clé publique ici
FEDAPAY_ENABLED=true
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
# Secret du endpoint Webhooks (wh_sandbox_…) — différent des clés API
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_CALLBACK_BASE_URL=http://localhost:5173/paiement
FEDAPAY_CUSTOMER_COUNTRY=tg

# --- Production / Render (ne pas utiliser en local) ---
# Voir Backend/.env.production.example et docs/RENDER.md
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=postgres://…   (Render) ou SPRING_DATASOURCE_URL=jdbc:postgresql://…
# APP_CORS_ALLOWED_ORIGINS=https://missanye-web.onrender.com
# JWT_COOKIE_SECURE=true
# JWT_COOKIE_SAME_SITE=None
# APP_STORAGE_ROOT=/app/uploads

