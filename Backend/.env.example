# Copier vers Backend/.env (non versionné) et renseigner les valeurs locales.
# Ne jamais committer de secrets réels.
# Au démarrage, LocalDotEnvLoader charge ce fichier s'il est présent.

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/church_project_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me-local

# Base64 d'au moins 32 octets aléatoires (ex. openssl rand -base64 32)
# Remplacer par une valeur unique locale — ne jamais réutiliser l'exemple en prod.
JWT_SECRET=

# Cookie d'auth HttpOnly (dev local via proxy Vite : Secure=false, SameSite=Lax)
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax
JWT_COOKIE_ENCRYPT=true

APP_ADMIN_SEED_PASSWORD=ChangeMeLocally123!

# Optionnel FedaPay sandbox
# FEDAPAY_ENABLED=true
# FEDAPAY_SECRET_KEY=
# FEDAPAY_WEBHOOK_SECRET=
