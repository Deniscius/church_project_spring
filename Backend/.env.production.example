# Référence des variables API pour Render / prod.
# Ne pas copier tel quel en local — utiliser Backend/.env (profil dev).
# Sur Render, renseigner via Dashboard (Environment), pas via fichier.

SPRING_PROFILES_ACTIVE=prod

# Option A (Render) : DATABASE_URL=postgres://…  → converti au boot
# Option B : JDBC explicite
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/missanye?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

JWT_SECRET=
JWT_COOKIE_SECURE=true
# *.onrender.com = cross-site (public suffix) → None. Domaines custom même eTLD+1 → Lax.
JWT_COOKIE_SAME_SITE=None
JWT_COOKIE_ENCRYPT=true

# SMTP obligatoire en prod (fail-closed)
APP_MAIL_FAIL_CLOSED=true
APP_MAIL_FROM=noreply@missanye.com
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PORT=587

# URL exacte du front (sans slash final), séparées par des virgules si plusieurs
APP_CORS_ALLOWED_ORIGINS=https://missanye-web.onrender.com

APP_STORAGE_ROOT=/app/uploads

HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=1
TOMCAT_MAX_THREADS=40

FEDAPAY_ENABLED=false
FEDAPAY_ENVIRONMENT=live
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_CALLBACK_BASE_URL=https://missanye-web.onrender.com/paiement
FEDAPAY_CUSTOMER_COUNTRY=tg
