<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" spacing="14" styleClass="content-card">
  <VBox spacing="14">
    <VBox spacing="5"><Label text="Demandes de messes" styleClass="section-title"/><Label text="Consultez les intentions et suivez leur règlement." wrapText="true" minHeight="-Infinity" styleClass="muted"/></VBox>

    <FlowPane hgap="10" vgap="8"><Label text="État de la demande"/><ComboBox fx:id="demandStateFilter" prefWidth="180"/><Label text="Paiement"/><ComboBox fx:id="paymentStateFilter" prefWidth="160"/></FlowPane>
    <TextField fx:id="demandSearch" promptText="Rechercher un téléphone, un code, un nom, une intention…" prefWidth="310" maxWidth="Infinity"/>
  </VBox>
  <TableView fx:id="demands" minHeight="120" prefHeight="240" VBox.vgrow="ALWAYS" styleClass="data-table">
    <columns>
      <TableColumn fx:id="demandReference" minWidth="125" text="Code de suivi" prefWidth="155"/>
      <TableColumn fx:id="demandFaithful" minWidth="125" text="Fidèle" prefWidth="160"/>
      <TableColumn fx:id="demandDate" minWidth="100" text="Célébration" prefWidth="110"/>
      <TableColumn fx:id="demandAmount" minWidth="100" text="Montant" prefWidth="120"/>
      <TableColumn fx:id="demandPayment" minWidth="100" text="Paiement" prefWidth="120"/>
      <TableColumn fx:id="demandState" minWidth="100" text="État de la demande" prefWidth="120"/>
      <TableColumn fx:id="demandCreated" minWidth="100" text="Date de dépôt" prefWidth="110"/>
      <TableColumn fx:id="demandValidation" minWidth="100" text="Validation" prefWidth="110"/>
    </columns>
    <placeholder><VBox alignment="CENTER" spacing="8"><Label text="Aucune demande à afficher" styleClass="empty-title"/><Label text="Actualisez la liste ou ajustez votre recherche." styleClass="muted"/></VBox></placeholder>
  </TableView>
  <VBox spacing="6" styleClass="selection-panel"><Label text="LA DEMANDE SÉLECTIONNÉE" styleClass="eyebrow"/><Label fx:id="detail" maxWidth="Infinity" minHeight="-Infinity" text="Sélectionnez une demande pour consulter son intention et agir." wrapText="true"/></VBox>
  <FlowPane hgap="8" vgap="8"><Button fx:id="cash" text="Encaisser en espèces" styleClass="primary-button"/><Button fx:id="printIntention" text="Feuille d’intentions du jour" styleClass="secondary-button"/><MenuButton fx:id="copyActions" text="Copier"><items><MenuItem fx:id="copyCode" text="Code de suivi"/><MenuItem fx:id="copyPhone" text="Téléphone du fidèle"/><MenuItem fx:id="copyDetails" text="Détails de la demande"/></items></MenuButton><Button fx:id="receipt" text="Imprimer / exporter le reçu" styleClass="secondary-button"/><Button fx:id="checkout" text="Paiement en ligne"/><Button fx:id="reconcile" text="Vérifier le règlement"/></FlowPane>
  <FlowPane hgap="8" vgap="8"><Button fx:id="correct" text="Corriger l'intention"/><Button fx:id="validate" text="Valider / rejeter"/><Button fx:id="remove" text="Supprimer la demande" styleClass="danger-button"/></FlowPane>
  <Label text="Retrouvez chaque demande avec son code de suivi." wrapText="true" minHeight="-Infinity" styleClass="help-text"/>
</VBox>
