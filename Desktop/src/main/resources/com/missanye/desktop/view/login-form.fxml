<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<GridPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="login-card" hgap="36" maxWidth="960">
  <columnConstraints><ColumnConstraints percentWidth="43" hgrow="ALWAYS"/><ColumnConstraints percentWidth="57" hgrow="ALWAYS"/></columnConstraints>
  <children>
    <VBox GridPane.columnIndex="0" spacing="18" alignment="CENTER_LEFT" styleClass="brand-panel">
      <StackPane maxWidth="98" minWidth="98" styleClass="brand-logo"><ImageView fitWidth="82" fitHeight="82" preserveRatio="true"><image><Image url="@../branding/missanye.png"/></image></ImageView></StackPane>
      <Label text="MISSANYE" styleClass="brand-name"/>
      <Label text="Le quotidien de votre paroisse, simplifié." wrapText="true" minHeight="-Infinity" styleClass="brand-title"/>
      <Label text="Accompagnez les fidèles. Retrouvez vos demandes, encaissements et reçus dans un seul espace." wrapText="true" minHeight="-Infinity" styleClass="brand-description"/>
      <Region prefHeight="18"/>
      <Label text="Un espace dédié à votre paroisse, avec les accès et les responsabilités de chacun." wrapText="true" minHeight="-Infinity" styleClass="brand-caption"/>
    </VBox>
    <VBox GridPane.columnIndex="1" spacing="12" styleClass="login-fields">
      <Label text="Bienvenue" styleClass="login-title"/>
      <Label text="Connectez-vous à votre espace de travail." wrapText="true" minHeight="-Infinity" styleClass="muted"/>
      <Label fx:id="serverEnvironment" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="help-text"/>
      <Label text="Identifiant" styleClass="field-label"/>
      <TextField fx:id="username" promptText="Votre identifiant" maxWidth="Infinity"/>
      <Label text="Mot de passe" styleClass="field-label"/>
      <PasswordField fx:id="password" promptText="Votre mot de passe" maxWidth="Infinity"/>
      <Button fx:id="login" text="Se connecter" styleClass="primary-button" defaultButton="true" maxWidth="Infinity"/>
      <Label fx:id="loginStatus" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="login-notice"/>
      <Label fx:id="offlineAvailability" visible="false" managed="false" text="Une connexion Internet est nécessaire lors de la première utilisation sur ce poste." wrapText="true" minHeight="-Infinity" styleClass="help-text"/>
      <TitledPane fx:id="offlinePane" disable="true" visible="false" managed="false" text="Accès local" expanded="false" animated="false" styleClass="offline-panel">
        <content>
          <VBox spacing="10">
            <Label text="Déjà connecté sur ce poste ? Utilisez votre mot de passe local pour retrouver votre travail." wrapText="true" minHeight="-Infinity" styleClass="muted"/>
            <PasswordField fx:id="localPassword" promptText="Mot de passe local du poste" maxWidth="Infinity"/>
            <Button fx:id="offline" text="Ouvrir mon espace hors connexion" styleClass="secondary-button" maxWidth="Infinity"/>
          </VBox>
        </content>
      </TitledPane>
      <Button fx:id="configureServer" text="Activer / configurer ce poste" styleClass="secondary-button"/>
      <Label text="Utilisez les mêmes identifiants que sur votre espace web." wrapText="true" minHeight="-Infinity" styleClass="help-text"/>
    </VBox>
  </children>
</GridPane>
