<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" spacing="14" styleClass="content-card">
  <VBox spacing="14">
    <VBox spacing="5"><Label text="Mon activité" styleClass="section-title"/><Label text="Retrouvez vos brouillons, les opérations à transmettre et les confirmations." wrapText="true" minHeight="-Infinity" styleClass="muted"/></VBox>
    <ComboBox fx:id="queueFilter" prefWidth="230" maxWidth="320"/>
  </VBox>
  <Label text="Un encaissement saisi hors connexion reste provisoire jusqu'à sa confirmation. Les opérations à corriger sont conservées." wrapText="true" minHeight="-Infinity" styleClass="notice"/>
  <TableView fx:id="outbox" minHeight="120" prefHeight="240" VBox.vgrow="ALWAYS" styleClass="data-table">
    <columns>
      <TableColumn fx:id="activityDate" minWidth="100" text="Date" prefWidth="110"/>
      <TableColumn fx:id="activityKind" minWidth="100" text="Opération" prefWidth="180"/>
      <TableColumn fx:id="activityReference" minWidth="125" text="Référence" prefWidth="165"/>
      <TableColumn fx:id="activityIntention" minWidth="100" text="Intention / demande" prefWidth="250"/>
      <TableColumn fx:id="activityState" minWidth="100" text="État" prefWidth="125"/>
    </columns>
    <placeholder><VBox alignment="CENTER" spacing="8"><Label text="Votre activité apparaîtra ici" styleClass="empty-title"/><Label text="Enregistrez une première demande pour commencer." styleClass="muted"/></VBox></placeholder>
  </TableView>
  <Label fx:id="queueDetail" maxWidth="Infinity" minHeight="-Infinity" text="Sélectionnez une opération pour consulter son état." wrapText="true" styleClass="selection-panel"/>
  <FlowPane hgap="8" vgap="8"><Button fx:id="queue" text="Finaliser la demande" styleClass="primary-button"/><Button fx:id="edit" text="Modifier le brouillon"/><Button fx:id="returnToDraft" text="Revenir au brouillon"/><Button fx:id="retry" text="Réessayer la transmission"/><Button fx:id="archive" text="Archiver"/></FlowPane>
</VBox>
