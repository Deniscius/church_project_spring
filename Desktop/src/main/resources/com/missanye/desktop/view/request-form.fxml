<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" styleClass="form-scroll">
  <content><VBox spacing="16" styleClass="content-card">
    <Label text="Nouvelle intention de messe" styleClass="section-title"/>
    <Label text="Préparez votre intention, puis enregistrez-la comme brouillon avant de la transmettre." wrapText="true" minHeight="-Infinity" styleClass="muted"/>
    <GridPane hgap="20" vgap="10">
      <columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/></columnConstraints>
      <children>
        <Label text="1  ·  La demande et son forfait" styleClass="form-section-title" GridPane.rowIndex="0" GridPane.columnSpan="2"/>
        <Label text="Type de demande" GridPane.rowIndex="1"/><Label text="Forfait" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <ComboBox fx:id="type" maxWidth="Infinity" minWidth="0" GridPane.rowIndex="2"/><ComboBox fx:id="plan" maxWidth="Infinity" minWidth="0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label fx:id="price" text="Sélectionnez un forfait pour connaître le montant" wrapText="true" minHeight="-Infinity" styleClass="price-label" GridPane.rowIndex="3" GridPane.columnSpan="2"/>
        <Label text="2  ·  Les coordonnées du fidèle" styleClass="form-section-title" GridPane.rowIndex="4" GridPane.columnSpan="2"/>
        <Label text="Nom du fidèle" GridPane.rowIndex="5"/><Label text="Prénom du fidèle" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <TextField fx:id="surname" GridPane.rowIndex="6"/><TextField fx:id="firstname" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        <Label text="Téléphone international" GridPane.rowIndex="7"/><Label text="Email (optionnel)" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
        <TextField fx:id="phone" promptText="+22890123456" GridPane.rowIndex="8"/><TextField fx:id="email" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
        <Label text="Coursier (optionnel)" GridPane.rowIndex="9" GridPane.columnSpan="2"/><TextField fx:id="courier" GridPane.rowIndex="10" GridPane.columnSpan="2"/>
        <Label text="3  ·  Le calendrier des célébrations" styleClass="form-section-title" GridPane.rowIndex="11" GridPane.columnSpan="2"/>
        <Label text="Première célébration" GridPane.rowIndex="12"/><Label text="Horaire" GridPane.rowIndex="12" GridPane.columnIndex="1"/>
        <DatePicker fx:id="date" maxWidth="Infinity" minWidth="0" GridPane.rowIndex="13"/><ComboBox fx:id="schedule" maxWidth="Infinity" minWidth="0" GridPane.rowIndex="13" GridPane.columnIndex="1"/>
        <Label text="Heure personnalisée (optionnelle)" wrapText="true" minHeight="-Infinity" GridPane.rowIndex="14"/>
        <TextField fx:id="customTime" promptText="Ex. 06:30" GridPane.rowIndex="15"/><Button fx:id="configureSlots" text="Configurer chaque date et horaire" wrapText="true" maxWidth="Infinity" GridPane.rowIndex="15" GridPane.columnIndex="1"/>
        <Label fx:id="slotsSummary" text="Horaire commun par défaut" wrapText="true" minHeight="-Infinity" styleClass="muted" GridPane.rowIndex="16" GridPane.columnSpan="2"/>
        <Label text="Autres dates du forfait" GridPane.rowIndex="17" GridPane.columnSpan="2"/>
        <VBox spacing="8" GridPane.rowIndex="18" GridPane.columnSpan="2">
          <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT"><DatePicker fx:id="additionalDate" promptText="Ajouter une célébration"/><Button fx:id="addDate" text="Ajouter la date"/><Button fx:id="removeDate" text="Retirer la date sélectionnée"/></FlowPane>
          <ListView fx:id="extraDates" prefHeight="76"><placeholder><Label text="Ajoutez les dates supplémentaires si votre forfait prévoit plusieurs célébrations." wrapText="true" minHeight="-Infinity" styleClass="help-text"/></placeholder></ListView>
        </VBox>
        <Label text="4  ·  Le règlement et l’intention" styleClass="form-section-title" GridPane.rowIndex="19" GridPane.columnSpan="2"/>
        <Label text="Mode de paiement" GridPane.rowIndex="20" GridPane.columnSpan="2"/>
        <ComboBox fx:id="payment" maxWidth="Infinity" minWidth="0" GridPane.rowIndex="21" GridPane.columnSpan="2"/>
        <Label text="Votre intention (10 à 500 caractères)" GridPane.rowIndex="22" GridPane.columnSpan="2"/>
        <TextArea fx:id="intention" prefRowCount="4" wrapText="true" GridPane.rowIndex="23" GridPane.columnSpan="2"/>
      </children>
    </GridPane>
    <FlowPane hgap="8" vgap="8"><Button fx:id="save" text="Enregistrer le brouillon" styleClass="primary-button"/><Button fx:id="fresh" text="Nouveau"/></FlowPane>
  </VBox></content>
</ScrollPane>
