<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.image.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="workbench" stylesheets="@desktop.css">
  <top>
    <HBox fx:id="appHeader" spacing="18" alignment="CENTER_LEFT" styleClass="app-header">
      <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="MISSANYE / ESPACE PAROISSIAL" styleClass="eyebrow"/><Label fx:id="pageTitle" text="Tableau de bord" styleClass="section-title"/></VBox>
      <Label fx:id="session" text="Coffre verrouillé" maxWidth="320" minWidth="0" wrapText="true" minHeight="-Infinity" styleClass="session-label"/>
      <Button fx:id="lock" text="Déconnexion" disable="true" styleClass="secondary-button"/>
    </HBox>
  </top>
  <left>
    <ScrollPane fx:id="sidebarContainer" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" prefWidth="228" minWidth="76" styleClass="sidebar-scroll">
      <content><VBox fx:id="sidebar" spacing="10" styleClass="sidebar" minHeight="-Infinity">
        <StackPane maxWidth="44" minWidth="44" styleClass="brand-logo"><ImageView fitWidth="32" fitHeight="32" preserveRatio="true"><image><Image url="@../branding/missanye.png"/></image></ImageView></StackPane>
        <Label fx:id="sidebarBrand" text="MISSANYE" styleClass="sidebar-brand"/>
        <Label fx:id="sidebarCaption" text="Votre paroisse, au quotidien." wrapText="true" minHeight="-Infinity" styleClass="sidebar-caption"/>
        <Separator/>
        <Button fx:id="navHome" text="Tableau de bord" maxWidth="Infinity" styleClass="nav-button" accessibleText="Tableau de bord"><graphic><SVGPath content="M2 10 L10 3 L18 10 M5 9 V18 H15 V9 M8 18 V12 H12 V18" styleClass="nav-icon"/></graphic></Button>
        <Button fx:id="navRequest" text="Nouvelle demande" maxWidth="Infinity" styleClass="nav-button" accessibleText="Nouvelle demande"><graphic><SVGPath content="M4 2 H13 L17 6 V19 H4 Z M8 11 H13 M10.5 8.5 V13.5" styleClass="nav-icon"/></graphic></Button>
        <Button fx:id="navDemands" text="Demandes et paiements" maxWidth="Infinity" styleClass="nav-button" accessibleText="Demandes et paiements"><graphic><SVGPath content="M3 4 H17 V18 H3 Z M3 8 H17 M7 4 V18 M10 12 H14 M10 15 H14" styleClass="nav-icon"/></graphic></Button>
        <Button fx:id="navActivity" text="Activité paroissiale" maxWidth="Infinity" styleClass="nav-button" accessibleText="Activité paroissiale"><graphic><SVGPath content="M3 10 A7 7 0 1 1 5 16 M3 4 V10 H9 M10 6 V11 L14 13" styleClass="nav-icon"/></graphic></Button>
        <Region minHeight="25" VBox.vgrow="ALWAYS"/>
        <VBox fx:id="sidebarHelp" spacing="7" styleClass="sidebar-help"><Label text="UN TRAVAIL TOUJOURS PROTÉGÉ" wrapText="true" minHeight="-Infinity" styleClass="sidebar-caption"/><Label text="Retrouvez les brouillons et opérations dans Activité paroissiale." wrapText="true" minHeight="-Infinity" styleClass="sidebar-caption"/></VBox>
      </VBox></content>
    </ScrollPane>
  </left>
  <center>
    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="workspace-scroll"><content>
    <VBox fx:id="workspace" spacing="18" disable="true" styleClass="workspace-body">
      <VBox spacing="12" styleClass="toolbar">
        <FlowPane hgap="10" vgap="10">
          <Label text="Paroisse" styleClass="field-label"/>
          <Label fx:id="parishIdentity" visible="false" managed="false" styleClass="field-label" wrapText="true" minHeight="-Infinity" maxWidth="280"/>
          <ComboBox fx:id="parish" prefWidth="240" minWidth="160"/>
          <Button fx:id="refresh" text="Actualiser" styleClass="secondary-button"/>
          <Button fx:id="sync" text="Transmettre les opérations" styleClass="primary-button"/>
          <CheckBox fx:id="auto" text="Envoi automatique" selected="true"/>
        </FlowPane>
      </VBox>
      <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="navigation-pages">
        <tabs><Tab text="Nouvelle demande"/><Tab text="Demandes et paiements"/><Tab text="Activité paroissiale"/><Tab text="Tableau de bord"/></tabs>
      </TabPane>
    </VBox>
    </content></ScrollPane>
  </center>
  <bottom>
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="status-bar">
      <ProgressIndicator fx:id="busyIndicator" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18" visible="false" managed="false"/>
      <Label fx:id="status" text="Connectez-vous pour accéder à votre espace paroissial." wrapText="true" minHeight="-Infinity" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>
  </bottom>
</BorderPane>
