# URL de l'API Spring Boot.
#
# Développement local :
#   VITE_API_BASE_URL=/api  → proxy Vite → http://127.0.0.1:8081
#
# Simuler la prod + partager (build + preview) :
#   npm run prod:share
#   ngrok http 4173
#   Ouvrir l’URL https://xxxx.ngrok-free.app → « Visit Site »
#   Puis FEDAPAY_CALLBACK_BASE_URL=https://xxxx.ngrok-free.app/paiement
#   (et redémarrer le backend)
#
# Accès direct au backend (sans proxy) :
#   VITE_API_BASE_URL=http://localhost:8081
#
# Build production :
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=/api

# URL publique canonique du front (OG, JSON-LD, sitemap logique).
# En local, DocumentMeta utilise window.location.origin.
# VITE_PUBLIC_SITE_URL=https://www.missanye.com
VITE_PUBLIC_SITE_URL=http://localhost:5173
