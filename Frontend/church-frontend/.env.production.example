# Copier vers .env.production (ne jamais committer le fichier réel).
# Sur Render Static Site : définir ces variables dans le Dashboard (build-time Vite).

# URL absolue du backend Spring (sans slash final).
VITE_API_BASE_URL=https://missanye-api.onrender.com

# URL publique canonique du front (sans slash final).
VITE_PUBLIC_SITE_URL=https://missanye-web.onrender.com
